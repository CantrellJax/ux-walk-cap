{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Cap UX",
	"mainBinaryName": "Cap",
	"identifier": "com.cantrell.cap-ux",
	"plugins": {
		"updater": {
			"endpoints": [
				"https://cdn.crabnebula.app/update/cap/cap/{{target}}/{{current_version}}"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyOTAzOTdFNzJFQkRFOTMKUldTVDN1dHlmam1RNHFXb1VYTXlrQk1iMFFkcjN0YitqZlA5WnZNY0ZtQ1dvM1dxK211M3VIYUQK"
		},
		"deep-link": {
			"desktop": {
				"schemes": ["cap-ux"]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": false,
		"targets": "all",
		"category": "Video",
		"longDescription": "Cap UX combines Cap screen recording and editing with UX Walk notes, chapters, transcripts and agent-ready evidence.",
		"externalBin": ["binaries/cap-muxer", "binaries/cap-cli"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"assets/branding/cap-ux.icns",
			"icons/icon.ico"
		],
		"resources": {
			"assets/backgrounds/macOS/*": "assets/backgrounds/macOS/",
			"assets/backgrounds/blue/*": "assets/backgrounds/blue/",
			"assets/backgrounds/cities/*": "assets/backgrounds/cities/",
			"assets/backgrounds/dark/*": "assets/backgrounds/dark/",
			"assets/backgrounds/orange/*": "assets/backgrounds/orange/",
			"assets/backgrounds/purple/*": "assets/backgrounds/purple/",
			"assets/music/*.mp3": "assets/music/"
		},
		"fileAssociations": [
			{
				"ext": ["cap"],
				"name": "Cap Project",
				"mimeType": "application/x-cap-project",
				"role": "Editor"
			}
		],
		"macOS": {
			"minimumSystemVersion": "15.0",
			"entitlements": "packaging/macos/Entitlements.plist",
			"frameworks": ["../../target/native-deps/Spacedrive.framework"],
			"dmg": {
				"background": "packaging/macos/dmg-background.png",
				"appPosition": {
					"x": 180,
					"y": 140
				},
				"applicationFolderPosition": {
					"x": 480,
					"y": 140
				}
			}
		},
		"windows": {
			"nsis": {
				"headerImage": "packaging/windows/nsis-header.bmp",
				"sidebarImage": "packaging/windows/nsis-sidebar.bmp",
				"installerIcon": "icons/icon.ico",
				"installerHooks": "packaging/windows/installer-hooks.nsh",
				"compression": "lzma"
			},
			"webviewInstallMode": {
				"type": "skip"
			}
		},
		"linux": {
			"deb": {
				"depends": [
					"libc6 (>= 2.39)",
					"libva2",
					"libva-drm2",
					"pulseaudio-utils",
					"libpipewire-0.3-0",
					"libasound2t64 | libasound2",
					"libxkbcommon0",
					"libxkbcommon-x11-0",
					"libx11-6",
					"libssl3t64 | libssl3",
					"libwayland-client0",
					"libwayland-egl1",
					"libegl1",
					"libvulkan1"
				]
			}
		}
	}
}
