{
	"name": "@cap-ux/cloud",
	"private": true,
	"type": "module",
	"scripts": {
		"web": "node web/build.mjs",
		"test": "npm run bundle && node --test test/*.test.mjs",
		"typecheck": "tsc --noEmit",
		"types": "wrangler types",
		"check": "npm run types && npm run typecheck && npm test && wrangler deploy --dry-run",
		"deploy": "npm run web && wrangler deploy",
		"bundle": "npm run web && wrangler deploy --dry-run --outdir dist",
		"auth:generate": "auth generate --config auth.config.ts --yes --output"
	},
	"devDependencies": {
		"auth": "1.7.14",
		"esbuild": "0.28.2",
		"miniflare": "5.20261019.2-beta",
		"typescript": "5.8.3",
		"wrangler": "4.152.0"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.14",
		"better-auth": "1.7.14"
	}
}
