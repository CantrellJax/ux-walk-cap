{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "capux",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-25",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "capux-media" }],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1,
		"traces": { "enabled": true, "head_sampling_rate": 0.1 }
	}
}
